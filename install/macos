#!/bin/sh

########
# Install bootstrap on macOS.
########

set -e

if [ "$(uname)" != "Darwin" ]; then
  printf "\nmacOS install can only run on Darwin hosts.\n" >&2
  exit 1
fi

REPO_URL="${BOOTSTRAP_REPO_URL:-https://github.com/drusellers/bootstrap.git}"
BOOTSTRAP_DIR="${BOOTSTRAP_DIR:-$HOME/.bootstrap}"

printf "\nInstalling bootstrap for macOS\n"

if ! xcode-select -p >/dev/null 2>&1; then
  printf "\nXcode Command Line Tools are required before bootstrap can clone this repository.\n"
  printf "Opening the installer now. Complete the installer dialog to continue bootstrap.\n"
  xcode-select --install || true

  attempts=120
  while ! xcode-select -p >/dev/null 2>&1; do
    if [ "$attempts" -le 0 ]; then
      printf "\nTimed out waiting for Xcode Command Line Tools installation.\n" >&2
      printf "Finish installation, then re-run this bootstrap command.\n" >&2
      exit 1
    fi

    sleep 15
    attempts=$((attempts - 1))
  done
fi

if ! git --version >/dev/null 2>&1; then
  printf "\nGit is required before bootstrap can clone this repository.\n" >&2
  printf "Install Xcode Command Line Tools, then re-run this bootstrap command.\n" >&2
  exit 1
fi

if [ -d "$BOOTSTRAP_DIR/.git" ]; then
  printf "Updating %s\n" "$BOOTSTRAP_DIR"
  git -C "$BOOTSTRAP_DIR" pull --ff-only
else
  if [ -e "$BOOTSTRAP_DIR" ]; then
    printf "ERROR: %s exists but is not a git repository.\n" "$BOOTSTRAP_DIR" >&2
    exit 1
  fi

  printf "Cloning %s into %s\n" "$REPO_URL" "$BOOTSTRAP_DIR"
  git clone "$REPO_URL" "$BOOTSTRAP_DIR"
fi

BOOTSTRAP_DIR=$(CDPATH= cd "$BOOTSTRAP_DIR" && pwd)
cd "$BOOTSTRAP_DIR"
sh "$BOOTSTRAP_DIR/setup/macos"
